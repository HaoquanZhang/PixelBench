{
  "models": {
    "2b": "Qwen/Qwen3-VL-2B-Instruct",
    "4b": "Qwen/Qwen3-VL-4B-Instruct",
    "8b": "Qwen/Qwen3-VL-8B-Instruct"
  },
  "data": {
    "instruction_source": "HuggingFaceM4/FineVision",
    "instruction_rows": 64000,
    "instruction_max_answer_tokens": 2048,
    "pixel_rows": 3000,
    "pixel_teacher": "pia_reduced",
    "palette_colors": 8,
    "resolutions": [16, 32, 64],
    "unique_pixel_images": true,
    "sampling_seed": 0,
    "joint_shuffle": true
  },
  "steps": {"fv": 1000, "additive": 1047, "fixed": 1000},
  "training": {
    "per_device_train_batch_size": 4,
    "gradient_accumulation_steps": 4,
    "learning_rate": 0.00001,
    "lr_scheduler_type": "cosine",
    "warmup_ratio": 0.03,
    "weight_decay": 0.0,
    "adam_beta1": 0.9,
    "adam_beta2": 0.999,
    "adam_epsilon": 1e-8,
    "max_grad_norm": 1.0,
    "bf16": true,
    "seed": 42,
    "data_seed": 42,
    "gradient_checkpointing": true
  }
}
